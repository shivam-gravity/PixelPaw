# Copy this file to .env and fill it in. Never commit .env.

# ── AI model ─────────────────────────────────────────────
LLM_PROVIDER=gemini                # gemini | openai
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash   # tried when the main model is busy
OPENAI_API_KEY=                    # https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible API works, e.g. a free local model with Ollama:
#   LLM_PROVIDER=openai  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.2
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=45

# ── OBS overlay + dashboard ──────────────────────────────
PIXELPAW_WEB_PORT=8765
PIXELPAW_WEB_HOST=127.0.0.1        # 0.0.0.0 = also reachable from your phone on the same Wi-Fi

# ── YouTube (OAuth desktop client, see README step 2) ────
YT_CLIENT_SECRETS=client_secret.json
YT_TOKEN_FILE=data/token.json

# ── Schedule ─────────────────────────────────────────────
PIXELPAW_TIMEZONE=Asia/Kolkata

# ── Where reports and alerts go (optional) ───────────────
DISCORD_WEBHOOK_URL=               # Server Settings → Integrations → Webhooks → Copy URL
TELEGRAM_BOT_TOKEN=                # from @BotFather
TELEGRAM_CHAT_ID=                  # your chat id (message @userinfobot)
